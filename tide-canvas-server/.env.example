# Tide Canvas server environment overrides (copy to .env and load into your shell).
# These override configs/config.yaml + configs/config.<env>.yaml.
# Prefix: TIDECANVAS_, dots -> underscores.

# Environment: test (default) | prod — selects the configs/config.<env>.yaml overlay.
TIDECANVAS_ENV=test

# Server
TIDECANVAS_SERVER_PORT=8080
TIDECANVAS_SERVER_MODE=debug

# MySQL
TIDECANVAS_MYSQL_HOST=127.0.0.1
TIDECANVAS_MYSQL_PORT=3306
TIDECANVAS_MYSQL_USER=root
TIDECANVAS_MYSQL_PASSWORD=root
TIDECANVAS_MYSQL_DATABASE=tidecanvas

# Redis
TIDECANVAS_REDIS_ADDR=127.0.0.1:6379
TIDECANVAS_REDIS_PASSWORD=
TIDECANVAS_REDIS_DB=0

# JWT (override the secret in any non-local environment)
TIDECANVAS_JWT_SECRET=change-me-in-production

# Model relay credential. The URL is not configurable: test uses
# https://test-relay.tcmzhan.com and prod uses https://relay.tcmzhan.com.
# Keep the real key out of YAML and source control.
TIDECANVAS_RELAY_APIKEY=
TIDECANVAS_WORLDLABS_APIKEY=
# Optional World Labs overrides:
# TIDECANVAS_WORLDLABS_POLLINTERVAL=5s
# TIDECANVAS_WORLDLABS_TIMEOUT=20m
TIDECANVAS_JWT_ACCESSTTL=2h
TIDECANVAS_JWT_REFRESHTTL=168h

# Admin supplier-balance monitor (server-side only; never expose to Next.js).
# Authorization is sent exactly as configured because DLAPI's account token is
# already an sk-* value and its /api/user/self endpoint accepts the raw value.
TIDECANVAS_BALANCEMONITOR_DLAPI_ACCESSTOKEN=
# Optional overrides:
# TIDECANVAS_BALANCEMONITOR_DLAPI_USERID=245
# TIDECANVAS_BALANCEMONITOR_DLAPI_LOWBALANCE=20

# Mikoto、CCGO、CCGO2 与 Dimensio 的开关、JWT 和预警线在管理后台
# 「配置管理 → 供应商余额」维护，保存后无需重启。

# Storage
TIDECANVAS_STORAGE_TYPE=local
TIDECANVAS_STORAGE_LOCALDIR=./data/uploads
TIDECANVAS_STORAGE_PUBLICURL=http://localhost:8080/static
# OSS 模式可选：关闭后上传走地域 Endpoint，上游取图使用 CDN（未配置则地域 OSS）。
TIDECANVAS_STORAGE_ACCELERATEENABLED=true
TIDECANVAS_STORAGE_ACCELERATEDOMAIN=

# CORS (Next.js dev origin)
# Note: list values via env are uncommon with viper; prefer config.yaml for cors.allowOrigins.
