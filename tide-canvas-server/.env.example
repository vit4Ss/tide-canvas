# Shell environment overrides for native backend development.
# The Go process does not auto-load this file. After copying it to .env, run:
#   set -a; . ./.env; set +a

TIDECANVAS_ENV=test

# Server
TIDECANVAS_SERVER_PORT=8080
TIDECANVAS_SERVER_MODE=debug

# MySQL
TIDECANVAS_MYSQL_HOST=127.0.0.1
TIDECANVAS_MYSQL_PORT=3306
TIDECANVAS_MYSQL_USER=root
TIDECANVAS_MYSQL_PASSWORD=root
TIDECANVAS_MYSQL_DATABASE=canvas

# Redis
TIDECANVAS_REDIS_ADDR=127.0.0.1:6379
TIDECANVAS_REDIS_PASSWORD=
TIDECANVAS_REDIS_DB=0

# Auth and model relay
TIDECANVAS_JWT_SECRET=local-only-change-before-sharing
TIDECANVAS_JWT_ACCESSTTL=2h
TIDECANVAS_JWT_REFRESHTTL=168h
TIDECANVAS_RELAY_APIKEY=

# Local storage is the safe development default.
TIDECANVAS_STORAGE_TYPE=local
TIDECANVAS_STORAGE_LOCALDIR=./data/uploads
TIDECANVAS_STORAGE_PUBLICURL=http://localhost:8080/static
TIDECANVAS_STORAGE_ENDPOINT=
TIDECANVAS_STORAGE_BUCKET=
TIDECANVAS_STORAGE_ACCESSKEY=
TIDECANVAS_STORAGE_SECRETKEY=
TIDECANVAS_STORAGE_PREFIX=canvas/uploads/
TIDECANVAS_STORAGE_CDNDOMAIN=
TIDECANVAS_STORAGE_ACCELERATEDOMAIN=

# Side-effecting integrations remain off unless every credential is supplied.
TIDECANVAS_EMAIL_ENABLED=false
TIDECANVAS_EMAIL_HOST=
TIDECANVAS_EMAIL_PORT=587
TIDECANVAS_EMAIL_USERNAME=
TIDECANVAS_EMAIL_PASSWORD=
TIDECANVAS_EMAIL_FROMADDRESS=
TIDECANVAS_EMAIL_FROMNAME="Tide Canvas"

TIDECANVAS_ELIANDAPAY_ENABLED=false
TIDECANVAS_ELIANDAPAY_MERCHANTID=
TIDECANVAS_ELIANDAPAY_MD5KEY=
TIDECANVAS_ELIANDAPAY_NOTIFYURL=http://localhost:8080/api/billing/notify
TIDECANVAS_ELIANDAPAY_RETURNURL=http://localhost:3000/billing?pay_status=success

TIDECANVAS_SEED_DEMO=0
