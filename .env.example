# Local Docker Compose defaults. Copy to .env only when you need overrides.
# This file contains no production credentials.

COMPOSE_PROJECT_NAME=tide-canvas-flowlight
FRONTEND_PORT=3000
BACKEND_PORT=8080
PUBLIC_API_ORIGIN=http://localhost:8080

MYSQL_DATABASE=canvas
MYSQL_ROOT_PASSWORD=tidecanvas-local-root
JWT_SECRET=local-only-change-before-sharing

# Optional integrations. Empty values keep the related feature unavailable.
RELAY_API_KEY=
SEED_DEMO=0
NEXT_PUBLIC_OAUTH_REDIRECT_BASE=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_WECHAT_APP_ID=
