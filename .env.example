# Runtime deployment environment; Docker uses NODE_ENV=production in both modes.
APP_ENV=test
# The existing shared backend, reached by the runtime Next.js proxy.
BACKEND_URL=http://127.0.0.1:8081

# Public identity. Change these before deploying your own brand/domain.
BRAND_NAME=Framelyn
SITE_URL=http://localhost:3100

# Google Identity Services. Public Web Client ID only; never a client secret.
# The shared backend must expose /api/auth/google/challenge and /api/auth/google.
GOOGLE_CLIENT_ID=

# Use the currency actually charged by the shared backend; no frontend conversion.
BILLING_CURRENCY=CNY

# Optional real support contact; leave empty until configured.
SUPPORT_EMAIL=

# Values are read at runtime; existing NEXT_PUBLIC_* local settings are fallbacks.
