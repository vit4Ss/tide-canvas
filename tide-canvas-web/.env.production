# 生产环境（next build / next start 自动加载本文件）。
# Docker 部署时 Dockerfile 的 --build-arg 优先级更高，会覆盖这里的值；
# 非 Docker 部署则以本文件为准。占位域名上线前必须替换。

# 后端 API 地址（生产公网地址或编排内服务名）
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com

# OAuth 相关（按需启用，值本身是公开的 client id，可提交）
# NEXT_PUBLIC_OAUTH_REDIRECT_BASE=https://www.yourdomain.com
# NEXT_PUBLIC_GITHUB_CLIENT_ID=
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_WECHAT_APP_ID=
