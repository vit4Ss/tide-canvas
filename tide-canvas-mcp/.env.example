# 主站地址：不包含 /api/open/v1，不使用第三方 Relay/APIRouter 的地址。
FLOWLIGHT_BASE_URL=http://127.0.0.1:8081
MCP_TRANSPORT=http
MCP_ADDR=127.0.0.1:8082
# 有浏览器跨域客户端时填写允许来源，多个值逗号分隔；原生 MCP 客户端不需要。
MCP_ALLOWED_ORIGINS=https://test-flowlight.tcmzhan.com,https://flowlight.tcmzhan.com
# 仅 stdio 模式使用。HTTP 模式始终使用请求携带的用户 Key，不使用共享 Key。
# FLOWLIGHT_API_KEY=你的主站用户APIKey
