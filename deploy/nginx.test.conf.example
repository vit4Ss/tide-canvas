# Test server. Configure HTTPS using your existing certificate tooling;
# keep the location settings in that host. This runs on the separate test host.
server {
    listen 80;
    server_name test-framelyn.tcmzhan.com;
    client_max_body_size 100m;
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    # Deliberately exclude text/event-stream from gzip_types.

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
