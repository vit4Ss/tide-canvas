# Branch preview deployment. Copy to a protected server-side .env file when
# deploying manually. GitHub Actions deployments use Environment secrets instead.

COMPOSE_PROJECT_NAME=tide-canvas-flowlight-preview
GHCR_OWNER=vit4ss
IMAGE_TAG=flowlight-20260809
FRONTEND_PORT=3000
BACKEND_PORT=8081
PUBLIC_API_ORIGIN=https://test-flowlight.tcmzhan.com

MYSQL_DATABASE=canvas
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
RELAY_API_KEY=

# Keep local storage for a self-contained preview. Set STORAGE_TYPE=oss and
# provide every required OSS value only when the preview must use cloud assets.
STORAGE_TYPE=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PREFIX=canvas/uploads/
STORAGE_CDN_DOMAIN=
STORAGE_ACCELERATE_DOMAIN=
