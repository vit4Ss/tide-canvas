# Copy these settings into the existing production Compose's .env on the server.
# Keep payment creation disabled until store review, product publication, and
# production API key + production Webhook registration have all been completed.
TIDECANVAS_PANCAKE_ENABLED=false
WAFFO_MERCHANT_ID=MER_2HQcr4GpEfaaTxdlz2EhR4
WAFFO_STORE_ID=STO_5sCh2znmw67eD0IDcdYF7r
WAFFO_PRODUCT_ID=PROD_1MtsJWKNihc87buXVcS4WE
# A PRODUCTION API private key, raw base64 on one line. Never reuse a test key.
WAFFO_PRIVATE_KEY=
# Generate on the server: openssl rand -hex 32
# This is an internal service token, not the Waffo key. Both services share it.
PAYMENTS_INTERNAL_TOKEN=
PAYMENTS_PORT=8083
