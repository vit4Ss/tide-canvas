+package com.scarecrowtoken.relay.service;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import java.util.*;
+
+/** OpenAI wire-format helpers. No routing credentials or billing state enter here. */
+public final class ChatProtocol {
+    private ChatProtocol() {}
+    public static final Set<String> OPTIONS = Set.of(
+            "tools", "tool_choice", "parallel_tool_calls", "temperature", "top_p", "stop",
+            "max_tokens", "max_completion_tokens", "response_format", "reasoning_effort",
+            "seed", "presence_penalty", "frequency_penalty", "stream_options", "user", "service_tier");
+
+    public static Map<String,Object> chatOptions(Map<String,Object> input) {
+        var out = new LinkedHashMap<String,Object>();
+        if (input != null) input.forEach((key,value) -> { if (OPTIONS.contains(key) && value != null) out.put(key,value); });
+        return out;
+    }
+
+    public static Map<String,Object> responsesOptions(Map<String,Object> input) {
+        var chat = chatOptions(input);
+        var out = new LinkedHashMap<String,Object>();
+        for (var key : List.of("temperature", "top_p", "parallel_tool_calls", "user", "service_tier"))
+            if (chat.containsKey(key)) out.put(key,chat.get(key));
+        if (chat.containsKey("max_completion_tokens") || chat.containsKey("max_tokens"))
+            out.put("max_output_tokens",chat.getOrDefault("max_completion_tokens",chat.get("max_tokens")));
+        if (chat.containsKey("reasoning_effort")) out.put("reasoning",Map.of("effort",chat.get("reasoning_effort")));
+        if (chat.get("tools") instanceof List<?> list) {
+            var tools = new ArrayList<Map<String,Object>>();
+            for (var raw : list) if (raw instanceof Map<?,?> tool) {
+                var next = stringMap(tool);
+                if ("function".equals(tool.get("type")) && tool.get("function") instanceof Map<?,?> function) {
+                    next = stringMap(function); next.put("type","function");
+                    // Chat tools default to non-strict; Responses defaults must
+                    // not unexpectedly reject an existing MCP JSON schema.
+                    next.putIfAbsent("strict",false);
+                }
+                tools.add(next);
+            }
+            out.put("tools",tools);
+        }
+        if (chat.containsKey("tool_choice")) {
+            Object choice = chat.get("tool_choice");
+            if (choice instanceof Map<?,?> selected && selected.get("function") instanceof Map<?,?> function)
+                choice = Map.of("type","function","name",function.get("name"));
+            out.put("tool_choice",choice);
+        }
+        if (chat.get("response_format") instanceof Map<?,?> format) {
+            var converted = new LinkedHashMap<String,Object>();
+            if ("json_schema".equals(format.get("type")) && format.get("json_schema") instanceof Map<?,?> schema) converted.putAll(stringMap(schema));
+            converted.put("type",format.get("type"));
+            out.put("text",Map.of("format",converted));
+        }
+        return out;
+    }
+
+    static Map<String,Object> stringMap(Map<?,?> source) {
+        var out = new LinkedHashMap<String,Object>();
+        source.forEach((key,value) -> { if (key instanceof String name) out.put(name,value); });
+        return out;
+    }
+
+    /** Responses message and function outputs both accept typed input parts. */
+    public static Object responsesContent(Object content) {
+        if (!(content instanceof List<?> list)) return content == null ? "" : String.valueOf(content);
+        var parts = new ArrayList<Map<String,Object>>();
+        for (var raw : list) {
+            if (!(raw instanceof Map<?,?> part)) continue;
+            switch (String.valueOf(part.get("type"))) {
+                case "text" -> parts.add(Map.of("type","input_text","text",String.valueOf(part.get("text"))));
+                case "image_url" -> {
+                    var image = part.get("image_url");
+                    var next = new LinkedHashMap<String,Object>();
+                    next.put("type","input_image");
+                    if (image instanceof Map<?,?> holder) {
+                        if (holder.get("url") != null) next.put("image_url",holder.get("url"));
+                        if (holder.get("detail") != null) next.put("detail",holder.get("detail"));
+                    } else if (image != null) next.put("image_url",image);
+                    parts.add(next);
+                }
+                case "file" -> {
+                    if (part.get("file") instanceof Map<?,?> file) {
+                        var next = new LinkedHashMap<String,Object>();
+                        next.put("type","input_file");
+                        for (var key : List.of("filename","file_data","file_id","file_url"))
+                            if (file.get(key) != null) next.put(key,file.get(key));
+                        parts.add(next);
+                    }
+                }
+                default -> { }
+            }
+        }
+        return parts;
+    }
+
+    public static final class ToolCalls {
+        private final SortedMap<Integer,Map<String,Object>> calls = new TreeMap<>();
+        private final Map<Integer,Integer> responseIndices = new HashMap<>();
+
+        public void chatDelta(JsonNode delta) {
+            for (var item : delta.path("tool_calls")) {
+                int index = item.path("index").asInt(0);
+                var target = calls.computeIfAbsent(index, ignored -> new LinkedHashMap<>(Map.of("type","function","function",new LinkedHashMap<String,Object>(Map.of("name","","arguments","")))));
+                if (item.hasNonNull("id")) target.put("id",item.path("id").asText());
+                @SuppressWarnings("unchecked") var function = (Map<String,Object>) target.get("function");
+                for (var name : List.of("name","arguments")) if (item.path("function").hasNonNull(name))
+                    function.put(name,String.valueOf(function.get(name)) + item.path("function").path(name).asText());
+            }
+        }
+
+        /** Translate Responses function events to a dense chat tool-call delta. */
+        public Map<String,Object> responseEvent(JsonNode event) {
+            String type = event.path("type").asText();
+            int output = event.path("output_index").asInt();
+            if ((type.equals("response.output_item.added") || type.equals("response.output_item.done")) &&
+                    event.path("item").path("type").asText().equals("function_call")) {
+                var item = event.path("item");
+                Integer existing = responseIndices.get(output);
+                if (existing == null) {
+                    int index = calls.size(); responseIndices.put(output,index);
+                    var fn = new LinkedHashMap<String,Object>();fn.put("name",item.path("name").asText());fn.put("arguments",item.path("arguments").asText(""));
+                    var call = new LinkedHashMap<String,Object>();call.put("id",item.path("call_id").asText());call.put("type","function");call.put("function",fn);
+                    calls.put(index,call);
+                    var delta = new LinkedHashMap<>(call);delta.put("index",index);return delta;
+                }
+                if (type.endsWith(".done")) return finishArguments(existing,item.path("arguments").asText(""));
+            }
+            Integer index = responseIndices.get(output);
+            if (index != null && type.equals("response.function_call_arguments.delta")) {
+                String text = event.path("delta").asText();
+                function(index).put("arguments",String.valueOf(function(index).get("arguments"))+text);
+                return Map.of("index",index,"function",Map.of("arguments",text));
+            }
+            if (index != null && type.equals("response.function_call_arguments.done"))
+                return finishArguments(index,event.path("arguments").asText());
+            return null;
+        }
+
+        @SuppressWarnings("unchecked")
+        private Map<String,Object> function(int index) { return (Map<String,Object>)calls.get(index).get("function"); }
+        private Map<String,Object> finishArguments(int index,String complete) {
+            String current = String.valueOf(function(index).get("arguments"));
+            if (current.equals(complete)) return null;
+            if (!complete.startsWith(current)) throw new IllegalStateException("inconsistent streamed function arguments");
+            function(index).put("arguments",complete);
+            return Map.of("index",index,"function",Map.of("arguments",complete.substring(current.length())));
+        }
+        public boolean isEmpty() { return calls.isEmpty(); }
+        public List<Map<String,Object>> list() { return new ArrayList<>(calls.values()); }
+    }
+}
