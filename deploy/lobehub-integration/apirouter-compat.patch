+package com.scarecrowtoken.relay.service;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.fasterxml.jackson.databind.PropertyNamingStrategies;
+import com.scarecrowtoken.relay.web.V1ChatController;
+import org.junit.jupiter.api.Test;
+import java.util.List;
+import java.util.Map;
+import static org.assertj.core.api.Assertions.assertThat;
+
+class ChatProtocolTest {
+    private final ObjectMapper json = new ObjectMapper();
+
+    @Test void publicRequestKeepsSupportedOptionsWithoutAllowingRouteOverrides() throws Exception {
+        var mapper = new ObjectMapper().setPropertyNamingStrategy(PropertyNamingStrategies.SNAKE_CASE);
+        var request = mapper.readValue("""
+                {"model":"gpt-6-astra","messages":[{"role":"user","content":"hi"}],"stream":true,
+                 "web_search":true,"tools":[{"type":"function","function":{"name":"lookup","parameters":{"type":"object"}}}],
+                 "tool_choice":"auto","max_completion_tokens":8192,"base_url":"https://attacker.test"}
+                """, V1ChatController.ChatCompletionsReq.class);
+        assertThat(request.webSearch()).isTrue();
+        assertThat(request.options()).containsKeys("tools","tool_choice","max_completion_tokens").doesNotContainKey("base_url");
+        assertThat(mapper.valueToTree(request).has("tools")).isTrue();
+    }
+
+    @Test void responsesOptionsTranslateFunctionsAndStructuredOutput() {
+        var schema = Map.of("type","object");
+        var options = ChatProtocol.responsesOptions(Map.of(
+                "tools",List.of(Map.of("type","function","function",Map.of("name","lookup","parameters",schema))),
+                "tool_choice",Map.of("type","function","function",Map.of("name","lookup")),
+                "max_completion_tokens",4096,"reasoning_effort","high",
+                "response_format",Map.of("type","json_schema","json_schema",Map.of("name","answer","schema",schema,"strict",true))));
+        var tree=json.valueToTree(options);
+        assertThat(tree.at("/tools/0/name").asText()).isEqualTo("lookup");
+        assertThat(tree.at("/tool_choice/name").asText()).isEqualTo("lookup");
+        assertThat(tree.at("/max_output_tokens").asInt()).isEqualTo(4096);
+        assertThat(tree.at("/reasoning/effort").asText()).isEqualTo("high");
+        assertThat(tree.at("/text/format/schema/type").asText()).isEqualTo("object");
+    }
+
+    @Test void responsesToolDeltasDoNotDuplicateFinalArguments() throws Exception {
+        var calls=new ChatProtocol.ToolCalls();
+        var start=calls.responseEvent(json.readTree("""
+                {"type":"response.output_item.added","output_index":3,"item":{"type":"function_call","id":"fc_a","call_id":"call_a","name":"lookup","arguments":""}}
+                """));
+        assertThat(start).containsEntry("index",0).containsEntry("id","call_a");
+        calls.responseEvent(json.readTree("""
+                {"type":"response.function_call_arguments.delta","output_index":3,"delta":"{}"}
+                """));
+        assertThat(calls.responseEvent(json.readTree("""
+                {"type":"response.function_call_arguments.done","output_index":3,"arguments":"{}"}
+                """))).isNull();
+        assertThat(calls.responseEvent(json.readTree("""
+                {"type":"response.output_item.done","output_index":3,"item":{"type":"function_call","call_id":"call_a","name":"lookup","arguments":"{}"}}
+                """))).isNull();
+        assertThat(json.valueToTree(calls.list()).at("/0/function/arguments").asText()).isEqualTo("{}");
+    }
+}
