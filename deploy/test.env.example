# The existing test backend also runs on 8081, on the test server.
# On a shared host, give the test frontend its own port, e.g. 3101,
# and explicitly select an isolated test backend using FRAMELYN_BACKEND_URL.
FRAMELYN_IMAGE=ghcr.io/vit4ss/tide-canvas-frontend-en:latest
FRAMELYN_PORT=3100
FRAMELYN_HOSTNAME=127.0.0.1
FRAMELYN_BACKEND_URL=http://127.0.0.1:8081
FRAMELYN_SITE_URL=https://test-framelyn.tcmzhan.com
FRAMELYN_BRAND_NAME=Framelyn
FRAMELYN_GOOGLE_CLIENT_ID=
FRAMELYN_BILLING_CURRENCY=USD
FRAMELYN_SUPPORT_EMAIL=
